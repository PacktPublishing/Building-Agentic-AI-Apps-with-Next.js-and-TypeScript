{
  "name": "mcp-amadeus-stdio",
  "version": "1.0.0",
  "description": "MCP STDIO server for Amadeus Travel API - Chapter 8",
  "type": "module",
  "bin": {
    "mcp-amadeus": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector@2.10.1 --protocol-era modern tsx src/index.ts"
  },
  "dependencies": {
    "amadeus": "^8.0.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "zod": "^4.4.3",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "@modelcontextprotocol/client": "2.3.1"
  }
}
