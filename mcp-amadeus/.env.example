# Server-only values. Replace in .env.local or deployment environment settings.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
MCP_BEARER_TOKEN=
# Comma-separated browser origins; native MCP clients without Origin still need a bearer token.
MCP_ALLOWED_ORIGINS=http://localhost:3000
# Enable only when explicitly debugging a local development process.
MCP_VERBOSE_LOGS=false
